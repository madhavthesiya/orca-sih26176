# ORCA configuration — copy to `.env` and edit. Everything is optional:
# with no .env at all, ORCA runs offline on labelled demo data.
# run-orca.sh loads this file automatically; on Windows set them in the shell.

# ---- backend ---------------------------------------------------------------
# DEMO  = cached, clearly-labelled scenario data (stage-safe, no internet)
# LIVE  = public marine/weather providers, falling back to DEMO on failure
ORCA_DATA_MODE=DEMO

# Seconds before a live provider call is abandoned for cached/demo data.
ORCA_LIVE_TIMEOUT=4.0

# Optional LLM rephrasing of answers. It never computes a risk score;
# leave the key empty to run fully rule-based.
ANTHROPIC_API_KEY=
ORCA_LLM_MODEL=claude-sonnet-5
# Set to 0 to keep the LLM off even when a key is present.
ORCA_USE_LLM=1

# Port the launcher serves the app on.
PORT=8000

# ---- frontend (frontend/.env, build time) ----------------------------------
# Only when the frontend is hosted apart from the API (e.g. Vercel + Render).
# Leave unset when the backend serves the built frontend itself.
# VITE_API_URL=https://your-orca-api.example.com
